NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms_dev
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms_test
REDIS_URL=redis://localhost:6379
PORT=5000

# Authentication (Auth0 tenant — see apps/api/src/auth/README.md)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.lms.app
AUTH0_CLIENT_ID=change-me
AUTH0_CLIENT_SECRET=change-me
AUTH0_CONNECTION=Username-Password-Authentication
# Optional: only needed to resend verification emails via the Management API.
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
AUTH_CLAIMS_NAMESPACE=https://lms.app/

REFRESH_SESSION_COOKIE_NAME=lms_sid
REFRESH_SESSION_TTL_SECONDS=604800

# Origins allowed to make credentialed requests (comma-separated).
CORS_ORIGIN=http://localhost:3000

# --- Local dev without a live Auth0 tenant -----------------------------
# Uncomment these three lines to enable "sign in as a seeded demo user"
# at http://localhost:3000/dev-login instead of real Auth0 login. NEVER
# enable in production (the API refuses to boot with DEV_AUTH_BYPASS=true
# and NODE_ENV=production — see packages/config/src/env.ts). The four
# AUTH0_* values above still need to be non-empty strings for the API's
# env validation to pass, even though this mode never calls Auth0 — any
# placeholder text works.
# DEV_AUTH_BYPASS=true
# AUTH_JWKS_URI=http://localhost:5000/api/v1/auth/dev/jwks
# AUTH_ISSUER=http://localhost:5000/api/v1/auth/dev/
