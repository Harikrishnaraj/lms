datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// Tenant root. Every tenant-owned table added in later phases carries
/// organizationId as a discriminator column scoped to this entity.
model Organization {
  id        String             @id @default(uuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  memberships Membership[]
  users       User[]
  departments Department[]

  @@map("organizations")
}

/// The 5 fixed platform roles (TRD §10.2). Not tenant-customizable in this
/// phase — one global row per key, shared across all organizations.
enum RoleKey {
  LEARNER
  TRAINER
  MANAGER
  HR_LD_ADMIN
  ORGANIZATION_ADMIN
}

model Role {
  id          String   @id @default(uuid())
  key         RoleKey  @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  memberships     Membership[]

  @@map("roles")
}

/// A discrete, granular permission string (e.g. "course:publish"), per TRD
/// §10.2. Permissions are global, not tenant-owned — what varies per tenant is
/// which users hold which role (see Membership).
model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// User-role assignment, scoped to a single organization. `userId` is the
/// identity provider's subject (JWT `sub`) — deliberately not a foreign key
/// to `users`, since a user can hold a Membership before the local `User`
/// profile has been created (e.g. auto-provisioned on first login). See
/// apps/api/src/tenancy/README.md for the isolation pattern this follows.
model Membership {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  roleId         String   @map("role_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([organizationId, roleId])
  @@map("memberships")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
}

/// Local profile for someone who exists in this organization. The identity
/// provider (Auth0) is still the source of truth for credentials — this row
/// stores organization-specific profile data (name, department, job title)
/// and the join key `externalId` (the IdP `sub` claim). `externalId` is
/// nullable so an admin can invite a user before their first Auth0 login;
/// once they log in for the first time, a webhook / provisioning step fills
/// it in and the row transitions from INVITED to ACTIVE.
model User {
  id             String     @id @default(uuid())
  organizationId String     @map("organization_id")
  /// Auth0 `sub` claim once the user has signed in at least once.
  externalId     String?    @map("external_id")
  email          String
  firstName      String     @map("first_name")
  lastName       String     @map("last_name")
  jobTitle       String?    @map("job_title")
  departmentId   String?    @map("department_id")
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  @@index([organizationId, externalId])
  @@map("users")
}

/// A grouping of users within one organization (e.g. Engineering, Sales).
/// Used for filters and, in a later phase, department-scoped auto-enrollment
/// rules. Names are unique per organization but names may collide across
/// organizations — enforced by the composite unique index.
model Department {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([organizationId, name])
  @@map("departments")
}
