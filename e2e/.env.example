# Copy to e2e/.env and fill in once a real Auth0 tenant exists.
# Until then every authenticated spec SKIPS (it does not fail) — see e2e/README.md.

# Targets. Defaults point at the deployed stack; override for local runs.
# WEB_BASE_URL=http://localhost:3000
# API_BASE_URL=http://localhost:5000/api/v1

# --- Org A (primary tenant) ---
E2E_TRAINER_EMAIL=
E2E_TRAINER_PASSWORD=

E2E_MANAGER_EMAIL=
E2E_MANAGER_PASSWORD=

E2E_HR_EMAIL=
E2E_HR_PASSWORD=

E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# --- Org B (second tenant, required for tenant-isolation.spec.ts) ---
E2E_OTHER_ORG_ADMIN_EMAIL=
E2E_OTHER_ORG_ADMIN_PASSWORD=
