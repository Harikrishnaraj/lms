{
  "name": "lms-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,css}\"",
    "clean": "turbo clean",
    "db:generate": "pnpm --filter @lms/database generate",
    "db:push": "pnpm --filter @lms/database push",
    "db:migrate": "pnpm --filter @lms/database migrate:dev",
    "db:seed": "pnpm --filter @lms/database seed",
    "db:studio": "pnpm --filter @lms/database studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
