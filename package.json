{
  "name": "lms-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,green\" \"corepack pnpm --filter api dev\" \"corepack pnpm --filter figma-make-app dev\"",
    "build": "corepack pnpm -r build",
    "db:generate": "corepack pnpm --filter db db:generate",
    "db:push": "corepack pnpm --filter db db:push",
    "db:seed": "corepack pnpm --filter db db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
